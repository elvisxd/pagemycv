{
  "name": "pagemycv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first browser bot that fills job application forms from your own CV.",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@webext-core/messaging": "^4.0.0",
    "hash-wasm": "^4.12.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "playwright": "1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "guard": "node scripts/guard.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm guard"
  }
