{
  "manifest_version": 3,
  "name": "spike-on-demand-injection",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "spike" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+9" } },
    "spike-fill": { "suggested_key": { "default": "Alt+Shift+8" }, "description": "spike" }
  }
}
